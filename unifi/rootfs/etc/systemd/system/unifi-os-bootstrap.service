[Unit]
Description=Initialize persistent UniFi OS Server installation
Wants=network.target systemd-logind.service
After=network.target systemd-logind.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/unifi-os-bootstrap
RemainAfterExit=yes
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
