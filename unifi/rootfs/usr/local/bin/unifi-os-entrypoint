#!/bin/bash
# App-owned container adapter.
set -euo pipefail

fail() {
    echo "UniFi OS startup refused: $*" >&2
    exit 1
}

[[ "${container:-}" == docker && $$ -eq 1 ]] \
    || fail "requires its own container PID namespace and PID 1"
[[ "$(stat -fc %T /sys/fs/cgroup)" == cgroup2fs ]] \
    || fail "requires cgroup v2"
[[ "$(cat /proc/self/cgroup)" == "0::/" ]] \
    || fail "requires a private cgroup namespace; will not modify host cgroups"
mountpoint -q /lib/unifi/data || fail "/lib/unifi/data must be Supervisor's persistent data mount"
[[ -c /dev/net/tun ]] || fail "/dev/net/tun is unavailable"

echo "EXPERIMENTAL: SYS_ADMIN, AppArmor disabled, private /proc protections relaxed."
echo "Production candidate: not approved for unattended production upgrades."

# Retain the complete storage root before the layout unit overlays its existing
# unifi/data subdirectory at the vendor path. Neither mount is a data symlink.
mkdir -p /var/lib/unifi-os-app
mount --bind /lib/unifi/data /var/lib/unifi-os-app
mkdir -p /var/lib/unifi-os-app/uos/home /var/lib/unifi-os-app/uos/state /var/lib/unifi-os-app/uos/bootstrap
chown uosserver:uosserver /var/lib/unifi-os-app/uos/home /var/lib/unifi-os-app/uos/state
chmod 0700 /var/lib/unifi-os-app/uos/bootstrap

# Optional throwaway deployment gate: networking is an operator concern, not
# migration logic. Never start copied controller data before quarantine.
if [[ -f /opt/unifi-os/require-isolation ]]; then
    echo "Waiting for device/cloud isolation for this container."
    for attempt in {1..300}; do
        if [[ -s /run/cid && -f /var/lib/unifi-os-app/uos/bootstrap/isolation-ready ]] \
            && cmp -s /run/cid /var/lib/unifi-os-app/uos/bootstrap/isolation-ready; then
            # Stop/start also loses namespace-local filters even if CID is the
            # same. Consume the test authorization; require a fresh preflight.
            rm /var/lib/unifi-os-app/uos/bootstrap/isolation-ready
            break
        fi
        [[ "${attempt}" -lt 300 ]] || fail "container network isolation not confirmed"
        sleep 1
    done
fi

# Stable per-installation identity, without sharing the image's machine ID.
if [[ ! -f /var/lib/unifi-os-app/uos/machine-id ]]; then
    systemd-id128 new > /var/lib/unifi-os-app/uos/machine-id
fi
grep -Eq '^[0-9a-f]{32}$' /var/lib/unifi-os-app/uos/machine-id \
    || fail "invalid persistent machine ID"
install -m 0444 /var/lib/unifi-os-app/uos/machine-id /etc/machine-id

# systemd manages only this container's private cgroups. Retain ALL Docker
# /proc protections here; rootless runtime preparation lives in a worker ns.
mount -o remount,rw /sys/fs/cgroup

# This interface controls the whole kernel, not just a PID/mount namespace.
# Keep Docker's read-only submount and fail closed if it is not effective.
[[ ! -w /proc/sysrq-trigger ]] || fail "kernel SysRq interface must remain read-only"

# Supervisor does not supply /run tmpfs. It is transient; no API access is used.
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mkdir -p /run/lock

# systemd replaces its own stdout with /dev/null. Keep a separate reader with
# the original Docker stdout; never write to Supervisor's host /dev/console.
mkfifo -m 0600 /run/unifi-os-log.pipe
setpriv --bounding-set=-all /bin/bash -c \
    'while true; do cat /run/unifi-os-log.pipe; done' &

# Drop optional Docker baseline capabilities, even on older Supervisors.
exec setpriv --bounding-set=-mknod,-net_raw,-audit_write,-setfcap \
    /usr/lib/systemd/systemd --log-target=null --show-status=no
