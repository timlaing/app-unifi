#!/bin/bash
# App-owned pre-installer compatibility step.
set -euo pipefail
umask 077

readonly data=/lib/unifi/data
readonly selection=/var/lib/unifi-os-app/mongo-runtime
readonly backups=/var/lib/unifi-os-app/mongo-originals
readonly runner=/usr/local/bin/unifi-os-mongo
[[ -f "${data}/system.properties" && -d "${data}/db" ]] || exit 0
[[ ! -L "${data}/db" ]] || { echo "Refusing symlink database" >&2; exit 1; }
exec 9>/run/unifi-mongo-prepare.lock
flock -n 9 || exit 1

fail() { echo "MongoDB preparation failed: $*; vendor startup blocked" >&2; exit 1; }
[[ -f "${data}/db/WiredTiger" ]] || fail "missing/unsupported WiredTiger database"
version=3.6
[[ ! -e "${selection}" ]] || version=$(cat "${selection}")
case "${version}" in 3.6|4.0|4.2|4.4) ;; *) fail "unknown runtime ${version}" ;; esac

# Even starting the old binary can perform journal recovery. Preserve the cold
# originals before opening them, not just before the first FCV change.
install -d -m 0700 "${backups}"
if [[ ! -e "${backups}/originals.tar" ]]; then
    [[ ! -e "${backups}/originals.tar.tmp" ]] || fail "incomplete original backup"
    tar -cpf "${backups}/originals.tar.tmp" -C "${data}" .
    tar -df "${backups}/originals.tar.tmp" -C "${data}"
    ln "${backups}/originals.tar.tmp" "${backups}/originals.tar"
    rm "${backups}/originals.tar.tmp"
    (cd "${backups}" && sha256sum originals.tar > originals.sha256)
    sync -f "${backups}/originals.tar"
    sync -f "${backups}/originals.sha256"
    echo "Cold legacy originals saved privately at ${backups}/originals.tar"
fi
(cd "${backups}" && sha256sum --status --check originals.sha256) || fail "original backup integrity"

work=$(mktemp -d /run/unifi-mongo-prepare.XXXXXX)
owner=$(stat -c %u "${data}/db")
group=$(stat -c %g "${data}/db")
chown "${owner}:${group}" "${work}"
pid=
stop() {
    if [[ -n "${pid}" ]]; then
        kill -TERM "${pid}"
        wait "${pid}"
        pid=
    fi
}
cleanup() {
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
        kill -TERM "${pid}"
        wait "${pid}" || true
    fi
}
trap cleanup EXIT
trap 'exit 1' TERM INT
query() { "${runner}" "${version}" mongo --quiet --host 127.0.0.1 --port 27118 --eval "$1"; }
start() {
    setpriv --reuid="${owner}" --regid="${group}" --clear-groups \
        "${runner}" "${version}" mongod --dbpath "${data}/db" \
        --bind_ip 127.0.0.1 --port 27118 --nounixsocket \
        --wiredTigerCacheSizeGB 0.25 --logpath "${work}/mongo-${version}.log" &
    pid=$!
    for ((attempt=0; attempt<60; attempt++)); do
        kill -0 "${pid}" 2>/dev/null || fail "MongoDB ${version} exited; see ${work}"
        if query 'quit(db.adminCommand({ping:1}).ok === 1 ? 0 : 1)' >/dev/null 2>&1; then return; fi
        sleep 1
    done
    fail "MongoDB ${version} did not become ready; see ${work}"
}
validate() {
    query 'db.getMongo().getDBNames().forEach(function(n) {
        var d=db.getSiblingDB(n);
        d.getCollectionInfos().forEach(function(c) {
            if(c.type !== "view") {
                var r=d.runCommand({validate:c.name,full:true});
                if(r.ok !== 1 || r.valid !== true) throw new Error("Invalid collection: "+n+"."+c.name);
            }
        });
    });' >/dev/null
}
start
server=$(query 'print(db.version().split(".").slice(0,2).join("."))')
[[ "${server}" == "${version}" ]] || fail "unexpected server version ${server}"
fcv=$(query "var r=db.adminCommand({getParameter:1,featureCompatibilityVersion:1}); assert.commandWorked(r); assert(!r.featureCompatibilityVersion.targetVersion || r.featureCompatibilityVersion.targetVersion === '${version}'); print(r.featureCompatibilityVersion.version)")
if [[ "${version}" == 4.2 && "${fcv}" == 4.2 || "${version}" == 4.4 && "${fcv}" == 4.4 ]]; then
    stop
    echo "MongoDB ${version}, FCV ${fcv}: already exporter-compatible; no format upgrade."
    exit 0
fi

while :; do
    case "${version}:${fcv}" in
        3.6:3.6|4.0:3.6|4.0:4.0|4.2:4.0|4.2:4.2|4.4:4.2|4.4:4.4) ;;
        *) fail "unsupported server/FCV ${version}/${fcv}" ;;
    esac
    # Idempotent MongoDB FCV command also completes an interrupted transition.
    query "assert.commandWorked(db.adminCommand({setFeatureCompatibilityVersion:'${version}'}))" >/dev/null
    fcv=$(query 'var r=db.adminCommand({getParameter:1,featureCompatibilityVersion:1}); assert.commandWorked(r); assert(!r.featureCompatibilityVersion.targetVersion); print(r.featureCompatibilityVersion.version)')
    [[ "${fcv}" == "${version}" ]] || fail "FCV checkpoint ${version}"
    validate
    stop
    echo "Validated in-place MongoDB ${version}, FCV ${fcv}."
    case "${version}" in
        3.6) version=4.0 ;; 4.0) version=4.2 ;; 4.2) version=4.4 ;; 4.4) break ;;
    esac
    # Only record the executable to use on restart; FCV is the upgrade checkpoint.
    printf '%s\n' "${version}" > "${selection}.tmp"
    chmod 0644 "${selection}.tmp"
    sync -f "${selection}.tmp"
    mv "${selection}.tmp" "${selection}"
    sync -f "${selection}"
    start
done
