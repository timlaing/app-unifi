#!/bin/bash
# App-owned compatibility launcher, not a patched vendor executable.
set -euo pipefail

# Provide the vendor's binary path using the retained database's runtime.
# Perform no conversion, backup or restore here.
version=3.6
selection=/var/lib/unifi-os-app/mongo-runtime
[[ ! -e "${selection}" ]] || version=$(cat "${selection}")
exec /usr/local/bin/unifi-os-mongo "${version}" mongod "$@"
