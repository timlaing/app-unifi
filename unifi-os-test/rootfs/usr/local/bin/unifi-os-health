#!/bin/bash
set -euo pipefail

[[ ! -w /proc/sysrq-trigger ]]

for unit in unifi-os-bootstrap.service uosserver.service uosserver-updater.service; do
    systemctl is-active --quiet "${unit}"
done

uid=$(id -u uosserver)
pid=$(systemctl show uosserver.service --property=MainPID --value)
[[ "$(awk '/^Uid:/{print $3}' "/proc/${pid}/status")" == "${uid}" ]]
runuser -u uosserver -- env "XDG_RUNTIME_DIR=/run/user/${uid}" \
    podman exec uosserver /bin/bash -c \
    'systemctl is-active --quiet unifi && curl -fsS --max-time 5 http://127.0.0.1/api/ping >/dev/null'
curl -kfsS --max-time 5 -o /dev/null https://127.0.0.1:11443/
